# Copy to .env and fill in only the keys for backends you actually use.
# Small/local models (Ollama) need NO key.

# --- Large / cloud models ---
OPENAI_API_KEY=          # gpt-4o, gpt-4o-mini, o3-mini, ... (also LLM-as-Judge)
GOOGLE_API_KEY=          # gemini-2.5-flash, gemini-2.5-pro

# OpenAI-compatible providers (pick the ones you use):
DEEPSEEK_API_KEY=        # deepseek-chat, deepseek-reasoner
DASHSCOPE_API_KEY=       # qwen-max, qwen-plus (Alibaba DashScope)
MOONSHOT_API_KEY=        # moonshot-v1-8k
ZHIPU_API_KEY=           # glm-4
# Generic fallback for any other OpenAI-compatible endpoint:
COMPAT_API_KEY=

# --- Local HuggingFace endpoint (optional) ---
HF_TOKEN=
